{
  "name": "leximate-backend",
  "version": "1.0.0",
  "description": "",
  "main": "build/index.js",
  "type": "commonjs",
  "scripts": {
    "load:workflows": "tsx scripts/load-n8n-workflows.ts",
    "load:credentials": "tsx scripts/load-n8n-credentials.ts",
    "load:all": "npm run load:credentials && npm run load:workflows",
    "start:dev": "nodemon",
    "start:build": "swc src -d dist && tsc-alias -p tsconfig.json",
    "start:prod": "node dist/index.js",
    "dev": "docker compose -f docker-compose.dev.yaml up --build",
    "dev:down": "docker compose -f docker-compose.dev.yaml down",
    "dev:logs": "docker compose -f docker-compose.dev.yaml logs -f",
    "dev:restart": "docker compose -f docker-compose.dev.yaml restart",
    "dev:rebuild": "docker compose -f docker-compose.dev.yaml down && docker compose -f docker-compose.dev.yaml build --no-cache && docker compose -f docker-compose.dev.yaml up -d",
    "prod": "docker compose up --build",
    "prod:down": "docker compose down",
    "prod:logs": "docker compose logs -f",
    "prod:rebuild": "docker compose down -v && docker compose build --no-cache && docker compose up -d",
    "docker:logs": "docker compose logs -f",
    "docker:logs:backend": "docker compose logs -f backend",
    "docker:logs:postgres": "docker compose logs -f postgres",
    "docker:logs:n8n": "docker compose logs -f n8n",
    "docker:db:up": "docker compose up -d postgres",
    "docker:db:down": "docker compose down postgres",
    "docker:db:reset": "docker compose down postgres && docker volume rm leximate-backend_postgres_data && docker compose up -d postgres",
    "docker:db:shell": "docker compose exec postgres psql -U postgres -d leximate",
    "docker:n8n:up": "docker compose up -d n8n",
    "docker:n8n:down": "docker compose down n8n",
    "docker:n8n:reset": "docker compose down n8n && docker volume rm leximate-backend_n8n_data && docker compose up -d n8n",
    "docker:backend:up": "docker compose up -d backend",
    "docker:backend:down": "docker compose down backend",
    "docker:backend:restart": "docker compose restart backend",
    "docker:backend:rebuild": "docker compose build --no-cache backend && docker compose up -d backend",
    "docker:clean": "docker compose down -v && docker system prune -f",
    "docker:status": "docker compose ps",
    "docker:shell:backend": "docker compose exec backend sh",
    "docker:shell:postgres": "docker compose exec postgres sh",
    "docker:restart": "docker compose restart",
    "docker:stop": "docker compose stop"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@fastify/cookie": "^11.0.2",
    "@fastify/cors": "^11.1.0",
    "@fastify/env": "^5.0.3",
    "@fastify/multipart": "^9.3.0",
    "@fastify/redis": "^7.1.0",
    "@fastify/static": "^8.3.0",
    "@fastify/swagger": "^9.6.1",
    "@fastify/swagger-ui": "^5.2.3",
    "@fastify/websocket": "^11.2.0",
    "ajv-errors": "^3.0.0",
    "axios": "^1.13.2",
    "bcryptjs": "^2.4.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cloudinary": "^2.5.1",
    "dotenv": "^16.4.5",
    "fastify": "^5.6.1",
    "fastify-plugin": "^5.1.0",
    "figlet": "^1.8.0",
    "form-data": "^4.0.4",
    "jsonwebtoken": "^9.0.2",
    "node-fetch": "^3.3.2",
    "pdf-parse": "^2.4.5",
    "pg": "^8.13.1",
    "redis": "^5.9.0",
    "reflect-metadata": "^0.2.2",
    "resend": "^4.0.1-alpha.0",
    "typeorm": "^0.3.27"
  },
  "devDependencies": {
    "@swc/cli": "^0.7.9",
    "@swc/core": "^1.15.1",
    "@types/bcryptjs": "^2.4.6",
    "@types/figlet": "^1.7.0",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/node": "^24.9.1",
    "@types/ws": "^8.18.1",
    "nodemon": "^3.1.7",
    "pino": "^10.1.0",
    "pino-colada": "^2.2.2",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.1.2",
    "rimraf": "^6.0.1",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tslib": "^2.8.1",
    "tsx": "^4.20.6",
    "typescript": "^5.6.3"
  }
}
